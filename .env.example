# Copie para .env (cp .env.example .env) e ajuste. Nunca faça commit do .env.
# O mesmo arquivo serve ao docker-compose.dev.yml, à API e ao Vite em desenvolvimento.

# --- Banco de dados ---------------------------------------------------------
POSTGRES_USER=livro
# Em produção, gere com `openssl rand -hex 32` (só letras e números, pois vai dentro de uma URL).
POSTGRES_PASSWORD=livro-dev
POSTGRES_DB=livro_de_receitas
# Porta do PostgreSQL de desenvolvimento no seu computador (docker-compose.dev.yml).
POSTGRES_DEV_PORT=5434

# --- API --------------------------------------------------------------------
# Em desenvolvimento aponta para o PostgreSQL do docker-compose.dev.yml.
# Em produção o docker-compose.yml monta este endereço a partir das variáveis POSTGRES_*.
DATABASE_URL=postgres://livro:livro-dev@localhost:5434/livro_de_receitas
# Porta da API em dev; o Vite encaminha /api para ela. Em produção a API usa 3000.
API_PORT=3001
# Interface onde a API escuta (padrão 0.0.0.0).
# API_HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Versão exibida em /api/health. Em produção vem da imagem Docker (tag do commit).
# APP_VERSION=dev

# --- Produção (docker-compose.yml) -----------------------------------------
# No servidor, o .env é gerado pelo deploy a partir dos GitHub Secrets e variáveis
# (veja docs/deploy.md). Os valores abaixo só importam para testar o compose localmente.
# Domínio do site; o Caddy emite o certificado HTTPS para ele.
SITE_DOMAIN=localhost
# Onde estão as imagens e qual tag rodar.
IMAGE_REGISTRY=ghcr.io/travensolli
IMAGE_TAG=latest
